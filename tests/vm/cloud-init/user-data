  - name: sysadmin
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash    
    passwd: $6$rounds=4096$jAWpGwGi4rgCdKM.$Qcoy7i1cudPQ9y7T.m3PiZ6XNnmiK3As8HTu58LijG5AForiDzT32eDvgoUXc1IlvGiaU7Ms1rWU4nP6jKNkb0 #PW: sysadmin
    lock_passwd: false
    ssh-authorized-keys:
      - ssh-rsa  keitarou@FIGHTER
      - ssh-rsa  keitarou@KEITAROU-TP

# If this is set, 'root' will not be able to ssh in and they 
# will get a message to login instead as the above $user (debian)
disable_root: true

# Allow SSH password auth as fallback.  Set to false to disable. 
ssh_pwauth: true

# Update apt database on first boot (run 'apt-get update')
package_update: true

# Upgrade the instance on first boot
package_upgrade: true

# Install the following packages on first boot - update kernel and reboot
runcmd:  
  - apt install -y curl git htop vim wget
  - apt install -y python3 python3-pip python3-pexpect python3-virtualenv python3-venv
  - apt install -y linux-image-6.12.12+bpo-cloud-arm64
  - reboot

# Reboot after package install/update if necessary
package_reboot_if_required: true

# Set System Timezone
timezone: America/Toronto