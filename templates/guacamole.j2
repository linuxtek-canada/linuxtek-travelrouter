# Docker Compose Reference Repo
# https://github.com/boschkundendienst/guacamole-docker-compose

networks:
  guacnetwork_compose:
    driver: bridge

services:
  guacd:
    container_name: guacd_compose
    image: guacamole/guacd:1.6.0-RC1
    platform: linux/arm64
    networks:
      - guacnetwork_compose
    restart: always
    volumes:
    - {{ env_vars.guacamole_drive_dir }}:/drive:rw
    - {{ env_vars.guacamole_record_dir }}:/record:rw

  postgres:
    container_name: postgres_guacamole_compose
    environment:
      PGDATA: /var/lib/postgresql/data/guacamole
      POSTGRES_DB: guacamole_db
      POSTGRES_PASSWORD: {{ env_vars.guacamole_postgres_password }}
      POSTGRES_USER: guacamole_user
    image: postgres:15.13-alpine3.22
    platform: linux/arm64/v8
    networks:
      - guacnetwork_compose
    restart: always
    volumes:
    - {{ env_vars.guacamole_init_dir }}:/docker-entrypoint-initdb.d:z
    - {{ env_vars.guacamole_data_dir }}:/var/lib/postgresql/data:Z

  guacamole:
    container_name: guacamole_compose
    group_add:
      - "1000"
    depends_on:
    - guacd
    - postgres
    environment:
      GUACD_HOSTNAME: guacd
      POSTGRES_DATABASE: guacamole_db
      POSTGRES_HOSTNAME: postgres
      POSTGRES_PASSWORD: {{ env_vars.guacamole_postgres_password }}
      POSTGRES_USER: guacamole_user
      RECORDING_SEARCH_PATH: /record
    image: guacamole/guacamole:1.6.0-RC1
    platform: linux/arm64
    networks:
      - guacnetwork_compose
    volumes:
      - {{ env_vars.guacamole_record_dir }}:/record:rw
    ports:
    # Note: Guacamole is on :8080/guacamole, not /.
    - {{ env_vars.guacamole_http_port }}:8080/tcp 
    
    restart: always